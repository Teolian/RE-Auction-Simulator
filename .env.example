# Database (use 'db' as host when running with Docker, 'localhost' for local dev)
DATABASE_URL=postgresql://re_user:re_password@db:5432/re_auction

# Timezone
TZ=Asia/Tokyo

# Backend API
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=your-secret-key-change-in-production
API_TOKEN=your-api-token-for-cron
RATE_LIMIT_PER_MINUTE=60

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000
